# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Real customer data (imports, exports). Never committed: the repo is public.
/private/

# Backend keys: only env/example.json is committed
/env/*.json
!/env/example.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Built APKs for installing on the phone (they carry the backend URL/key)
/release/
